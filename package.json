{
  "name": "bps-luwu-kinerja-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:pg:init": "psql -h 127.0.0.1 -U postgres -d kinerja_pegawai_bps -f db/postgres_init.sql",
    "db:pg:check": "psql -h 127.0.0.1 -U postgres -d kinerja_pegawai_bps -c \"select current_database(), current_schema();\"",
    "security:scan-sql": "node ../scripts/audit-mysql-compat.mjs ./src",
    "smoke:test": "node ../scripts/smoke-test-api.mjs",
    "backup:postgres": "bash ../scripts/backup-postgres.sh",
    "restore:test": "bash ../scripts/test-restore-postgres.sh"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "@types/pg": "^8.11.10"
  }
}
